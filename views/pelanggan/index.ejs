<%- include('../partials/top', { title, activePage }) %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div></div>
    <button class="btn btn-primary btn-sm" id="btnAdd"><i class="bi bi-plus"></i> Tambah Pelanggan</button>
  </div>

  <div class="card p-3">
    <table id="tblPelanggan" class="table table-hover mb-0" style="width:100%">
      <thead>
        <tr>
          <th style="width:50px">No</th>
          <th>Nama</th>
          <th>No. Telp</th>
          <th style="width:120px">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(function(item, i) { %>
          <tr>
            <td>
              <%= i + 1 %>
            </td>
            <td>
              <%= item.nama %>
            </td>
            <td>
              <%= item.no_telp || '-' %>
            </td>
            <td>
              <% 
                var waNumber = '';
                if (item.no_telp) {
                  waNumber = item.no_telp.replace(/\D/g, '');
                  if (waNumber.startsWith('0')) {
                    waNumber = '62' + waNumber.substring(1);
                  }
                }
              %>
              <% if (waNumber) { %>
                <a href="https://wa.me/<%= waNumber %>" target="_blank" class="btn btn-sm btn-outline-success me-1" title="Chat WhatsApp">
                  <i class="bi bi-whatsapp"></i>
                </a>
              <% } %>
              <button class="btn btn-sm btn-outline-secondary btn-edit" data-id="<%= item.id %>"
                data-nama="<%= item.nama %>" data-telp="<%= item.no_telp || '' %>">
                <i class="bi bi-pencil"></i>
              </button>
            </td>
          </tr>
          <% }); %>
      </tbody>
    </table>
  </div>

  <div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Pelanggan</h5><button type="button" class="btn-close"
            data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editId">
          <div class="mb-3"><label class="form-label small">Nama</label><input type="text" class="form-control"
              id="nama" placeholder="Nama pelanggan"></div>
          <div class="mb-3"><label class="form-label small">No. Telepon</label><input type="text" class="form-control"
              id="no_telp" placeholder="08xxx"></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
          <button class="btn btn-primary btn-sm" id="btnSave">Simpan</button>
        </div>
      </div>
    </div>
  </div>

  <script>
$(function() {
  $('#tblPelanggan').DataTable({ order: [], language: dtLanguageID });

  var formModal = new bootstrap.Modal(document.getElementById('formModal'));

  $('#btnAdd').on('click', function() {
    $('#editId').val('');
    $('#nama').val('');
    $('#no_telp').val('');
    $('.modal-title').text('Tambah Pelanggan');
    formModal.show();
  });

  $(document).on('click', '.btn-edit', function() {
    var $b = $(this);
    $('#editId').val($b.data('id'));
    $('#nama').val($b.data('nama'));
    $('#no_telp').val($b.data('telp'));
    $('.modal-title').text('Edit Pelanggan');
    formModal.show();
  });

  $(document).on('click', '.btn-del', function() {
    confirmDelete($(this).data('id'), $(this).data('url'));
  });

  $('#btnSave').on('click', function() {
    var btn = this;
    if (!setBtnLoading(btn)) return;
    var id = $('#editId').val();
    $.ajax({ url: id ? '/pelanggan/' + id : '/pelanggan', method: id ? 'PUT' : 'POST',
      contentType: 'application/json', data: JSON.stringify({ nama: $('#nama').val(), no_telp: $('#no_telp').val() }),
      success: function(r) { if (r.success) location.reload(); else resetBtn(btn); },
      error: function(xhr) { showToast((xhr.responseJSON && xhr.responseJSON.message) || 'Gagal', 'danger'); resetBtn(btn); }
    });
  });
});
  </script>

  <%- include('../partials/bottom') %>