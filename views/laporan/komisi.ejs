<% function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); } %>
  <%- include('../partials/top', { title, activePage }) %>
    <%- include('../partials/select2') %>


      <div class="card p-3 mb-3">
        <form method="get" action="/laporan/komisi" class="row g-2 align-items-end">
          <div class="col-auto">
            <label class="form-label small mb-0">Bulan</label>
            <select class="form-select form-select-sm" name="bulan">
              <% var
                months=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
                %>
                <% for(var i=1; i<=12; i++) { %>
                  <option value="<%= i %>" <%=filters.bulan===i ? 'selected' : '' %>><%= months[i-1] %>
                  </option>
                  <% } %>
            </select>
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Tahun</label>
            <select class="form-select form-select-sm" name="tahun">
              <% var curYear=new Date().getFullYear(); %>
                <% for(var y=curYear - 2; y <=curYear + 2; y++) { %>
                  <option value="<%= y %>" <%=filters.tahun===y ? 'selected' : '' %>><%= y %>
                  </option>
                  <% } %>
            </select>
          </div>
          <div class="col-auto" style="min-width: 200px;">
            <label class="form-label small mb-0">Sales</label>
            <select class="form-select form-select-sm" name="sales_id">
              <option value="">Semua Sales</option>
              <% salesList.forEach(function(s) { %>
                <option value="<%= s.id %>" <%=filters.sales_id==s.id ? 'selected' : '' %>><%= s.nama %>
                </option>
                <% }); %>
            </select>
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Kategori</label>
            <select class="form-select form-select-sm" name="tipe">
              <option value="frame" <%=filters.tipe==='frame' ? 'selected' : '' %>>Frame</option>
              <option value="lensa" <%=filters.tipe==='lensa' ? 'selected' : '' %>>Lensa</option>
              <option value="semua" <%=filters.tipe==='semua' ? 'selected' : '' %>>Semua Kategori</option>
            </select>
          </div>
          <div class="col-auto">
            <button class="btn btn-primary btn-sm"><i class="bi bi-funnel"></i> Tampilkan</button>
          </div>
        </form>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <div class="stat-card">
            <i class="bi bi-people stat-icon text-info"></i>
            <div class="stat-value">
              <%= data.length %>
            </div>
            <div class="stat-label">Sales</div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card">
            <i class="bi bi-receipt stat-icon text-success"></i>
            <div class="stat-value">
              <%= data.reduce(function(s,r){ return s + parseInt(r.total_transaksi||0); }, 0) %>
            </div>
            <div class="stat-label">Total Transaksi Lunas</div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card">
            <i class="bi bi-cash-stack stat-icon text-warning"></i>
            <div class="stat-value">
              <%= fmtRp(grandTotal) %>
            </div>
            <div class="stat-label">Total Komisi</div>
          </div>
        </div>
      </div>

      <div class="card p-3">
        <table id="tblKomisi" class="table table-hover mb-0" style="width:100%">
          <thead>
            <tr>
              <th>Sales</th>
              <th>Komisi Lensa</th>
              <th>Komisi Frame</th>
              <th>Transaksi Lunas</th>
              <th>Total Lensa</th>
              <th>Total Frame</th>
              <th>Total Penjualan</th>
              <th>Total Komisi</th>
              <th class="text-center">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% data.forEach(function(row) { %>
              <tr>
                <td class="fw-bold">
                  <%= row.sales_nama %>
                </td>
                <td><span class="badge bg-info bg-opacity-25 text-info">
                    <%= row.komisi_lensa || 0 %>%
                  </span></td>
                <td><span class="badge bg-primary bg-opacity-25 text-primary">
                    <%= row.komisi_frame || 0 %>%
                  </span></td>
                <td>
                  <%= row.total_transaksi %>
                </td>
                <td>
                  <%= fmtRp(row.total_penjualan_lensa) %>
                </td>
                <td>
                  <%= fmtRp(row.total_penjualan_frame) %>
                </td>
                <td>
                  <%= fmtRp(row.total_penjualan) %>
                </td>
                <td class="fw-bold text-success">
                  <%= fmtRp(row.total_komisi) %>
                </td>
                <td class="text-center">
                  <button type="button" onclick="showDetailModal(<%= row.sales_id %>, <%= filters.bulan %>, <%= filters.tahun %>, '<%= filters.tipe %>')" class="btn btn-sm btn-outline-primary" title="Detail Komisi">
                    <i class="bi bi-list-check"></i> Detail
                  </button>
                </td>
              </tr>
              <% }); %>
          </tbody>
          <tfoot>
            <tr class="table-active">
              <td colspan="7" class="text-end fw-bold">Grand Total Komisi</td>
              <td class="fw-bold text-success fs-5">
                <%= fmtRp(grandTotal) %>
              </td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      
      <!-- Modal Detail -->
      <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header no-print">
              <h5 class="modal-title">Detail Komisi - <span id="mdlSalesName"></span></h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="printArea">
              <div class="d-none d-print-block mb-3 border-bottom pb-2">
                <h3 class="mb-1">Laporan Detail Komisi</h3>
                <p class="mb-0">
                  Sales: <strong id="printSalesName"></strong><br>
                  Bulan: <strong id="printBulan"></strong><br>
                  Kategori: <strong id="printKategori"></strong>
                </p>
              </div>
              <div class="d-print-none mb-3">
                Bulan: <strong id="mdlBulan"></strong> &nbsp;|&nbsp; 
                Kategori: <strong id="mdlKategori"></strong>
              </div>
              <table class="table table-bordered table-striped" id="tblDetail">
                <thead class="table-light">
                  <tr>
                    <th>No</th>
                    <th>Nomor Invoice</th>
                    <th>Tanggal Invoice</th>
                    <th>Tanggal Masuk Komisi</th>
                    <th>Tipe</th>
                    <th class="text-end">Total Penjualan</th>
                    <th class="text-end" id="colSubtotal">Subtotal Penjualan</th>
                    <th class="text-end" id="colKomisi">Komisi</th>
                  </tr>
                </thead>
                <tbody id="mdlBody"></tbody>
                <tfoot>
                  <tr class="table-active">
                    <td colspan="7" class="text-end fw-bold">Total Komisi Diterima</td>
                    <td class="text-end fw-bold text-success fs-5" id="mdlGrandTotal"></td>
                  </tr>
                </tfoot>
              </table>
            </div>
            <div class="modal-footer no-print">
              <button class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
              <button class="btn btn-primary" onclick="printKomisi()"><i class="bi bi-printer"></i> Print</button>
            </div>
          </div>
        </div>
      </div>
      
      <style>
        @media print {
          body.printing-komisi > * { display: none !important; }
          body.printing-komisi > #printContainer {
            display: block !important;
          }
          #printContainer {
            display: none;
          }
          #printContainer table { page-break-inside: auto; }
          #printContainer tr { page-break-inside: avoid; page-break-after: auto; }
          #printContainer thead { display: table-header-group; }
          #printContainer tfoot { display: table-footer-group; }
        }
      </style>

      <script>

function printKomisi() {
  // Clone the printArea content into a top-level container
  var container = document.getElementById('printContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'printContainer';
    document.body.appendChild(container);
  }
  container.innerHTML = document.getElementById('printArea').innerHTML;
  document.body.classList.add('printing-komisi');
  window.print();
  document.body.classList.remove('printing-komisi');
  container.innerHTML = '';
}

function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

function showDetailModal(sales_id, pBulan, pTahun, pTipe) {
  const bulan = pBulan;
  const tahun = pTahun;
  const tipe = pTipe;

  fetch('/laporan/komisi/detail/' + sales_id + '?bulan=' + bulan + '&tahun=' + tahun + '&tipe=' + tipe)
    .then(res => res.json())
    .then(data => {
      document.getElementById('mdlSalesName').innerText = data.sales.nama;
      document.getElementById('printSalesName').innerText = data.sales.nama;
      
      const bulanStr = months[parseInt(data.filters.bulan) - 1] + ' ' + data.filters.tahun;
      document.getElementById('mdlBulan').innerText = bulanStr;
      document.getElementById('printBulan').innerText = bulanStr;
      
      const tipeStr = data.filters.tipe === 'semua' ? 'Semua Kategori' : (data.filters.tipe === 'frame' ? 'Frame' : 'Lensa');
      document.getElementById('mdlKategori').innerText = tipeStr;
      document.getElementById('printKategori').innerText = tipeStr;

      let subtotalLabel = data.filters.tipe === 'semua' ? 'Subtotal Penjualan (Semua)' : ('Subtotal Penjualan ' + tipeStr);
      document.getElementById('colSubtotal').innerText = subtotalLabel;

      let html = '';
      if (data.details.length === 0) {
        html = '<tr><td colspan="7" class="text-center text-muted">Tidak ada data komisi</td></tr>';
      } else {
        data.details.forEach((d, idx) => {
          html += '<tr>' +
            '<td>' + (idx + 1) + '</td>' +
            '<td>' + d.no_nota + '</td>' +
            '<td>' + new Date(d.order_date).toLocaleDateString('id-ID') + '</td>' +
            '<td>' + new Date(d.tanggal_masuk).toLocaleDateString('id-ID') + ' ' + new Date(d.tanggal_masuk).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) + '</td>' +
            '<td>' + (d.tipe === 'frame' ? 'Frame' : 'Lensa') + '</td>' +
            '<td class="text-end">' + fmtRp(d.total_penjualan) + '</td>' +
            '<td class="text-end">' + fmtRp(d.subtotal_kategori) + '</td>' +
            '<td class="text-end fw-bold text-success">' + fmtRp(d.nominal_komisi) + '</td>' +
            '</tr>';
        });
      }
      document.getElementById('mdlBody').innerHTML = html;
      document.getElementById('mdlGrandTotal').innerText = fmtRp(data.grandTotal);

      new bootstrap.Modal(document.getElementById('detailModal')).show();
    });
}

$(function() {
  $('#tblKomisi').DataTable({ order: [], language: dtLanguageID, paging: false, info: false });
  $('select[name="sales_id"]').select2({ theme: 'bootstrap-5', placeholder: 'Semua Sales', allowClear: true });
});
      </script>

      <%- include('../partials/bottom') %>