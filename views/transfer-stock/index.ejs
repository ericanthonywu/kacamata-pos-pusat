<%- include('../partials/top', { title, activePage }) %>
<%- include('../partials/select2') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="mb-0">Transfer Stok ke Cabang Ketapang</h5>
    <small class="text-muted">Kirim stok barang langsung dari Gudang KL ke Cabang Ketapang</small>
  </div>
  <div class="small text-muted" id="mitraStatus">
    Cabang Ketapang: <span id="mitraStatusText">Memuat...</span>
    <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-decoration-none" onclick="loadExternalItems()" title="Muat ulang data Cabang Ketapang">
      <i class="bi bi-arrow-clockwise"></i>
    </button>
  </div>
</div>

<div class="row g-3">
  <!-- LEFT: Info Transfer -->
  <div class="col-md-4">
    <div class="card p-3 mb-3">
      <h6 class="mb-3">Info Transfer</h6>

      <div class="mb-3">
        <label class="form-label small">Tujuan Transfer</label>
        <input type="text" class="form-control form-control-sm fw-semibold bg-body-tertiary" value="Cabang Ketapang" readonly>
        <div class="form-text small">Stok di Gudang KL akan berkurang dan dikirim ke Cabang Ketapang.</div>
      </div>

      <div class="mb-3">
        <label class="form-label small">Tanggal</label>
        <input type="date" class="form-control" id="tanggal" value="<%= todayStr() %>">
      </div>

      <div class="mb-0">
        <label class="form-label small">Catatan</label>
        <textarea class="form-control" id="notes" rows="3" placeholder="Catatan transfer (opsional)..."></textarea>
      </div>
    </div>

    <!-- Riwayat Sesi Ini -->
    <div class="card p-3">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Riwayat Sesi Ini</h6>
        <span class="badge bg-secondary" id="sessionCount">0</span>
      </div>
      <div id="sessionLogs" class="small text-muted" style="max-height: 280px; overflow-y: auto;">
        Belum ada transaksi transfer pada sesi ini.
      </div>
    </div>
  </div>

  <!-- RIGHT: Items -->
  <div class="col-md-8">
    <div class="card p-3 mb-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">📦 Item Transfer</h6>
        <button class="btn btn-sm btn-outline-primary" type="button" onclick="addItem()">
          <i class="bi bi-plus"></i> Tambah Item
        </button>
      </div>

      <div id="itemList">
        <!-- Dynamic item rows will be rendered here -->
      </div>

      <div id="emptyMsg" class="text-center text-muted py-4" style="display: none;">
        <i class="bi bi-inbox" style="font-size: 1.5rem;"></i>
        <div class="small mt-1">Belum ada item transfer. Klik <strong>"Tambah Item"</strong> untuk mulai.</div>
      </div>
    </div>

    <!-- Summary & Save -->
    <div class="card p-3">
      <div class="row g-2 align-items-center">
        <div class="col-6"><strong class="fs-5">TOTAL ITEM</strong></div>
        <div class="col-6 text-end fw-bold fs-5 text-primary" id="totalDisplay">0 Barang (0 Pcs)</div>
      </div>
      <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary flex-fill" id="btnSimpan" onclick="saveTransfer(this)">
          <i class="bi bi-send-check me-1"></i> Transfer ke Cabang Ketapang
        </button>
      </div>
    </div>
  </div>
</div>

<script>
var barangMap = {};
<% barangList.forEach(function(b) { %>
  barangMap[<%= b.id %>] = {
    id: <%= b.id %>,
    nama_barang: <%- JSON.stringify(b.nama_barang) %>,
    barcode_id: <%- JSON.stringify(b.barcode_id || '') %>,
    sph_r: <%- JSON.stringify(b.sph_r || '') %>,
    sph_l: <%- JSON.stringify(b.sph_l || '') %>,
    cyl_r: <%- JSON.stringify(b.cyl_r || '') %>,
    cyl_l: <%- JSON.stringify(b.cyl_l || '') %>,
    add_r: <%- JSON.stringify(b.add_r || '') %>,
    add_l: <%- JSON.stringify(b.add_l || '') %>,
    qty: <%= Number(b.qty || 0) %>
  };
<% }); %>

var externalItems = [];
var externalLoaded = false;
var itemIndex = 0;
var sessionLogs = [];

function formatPrescription(b) {
  var sph = b.sph_r || b.sph_l || b.sph || '';
  var cyl = b.cyl_r || b.cyl_l || b.cyl || '';
  var add = b.add_r || b.add_l || b.add || '';
  if (sph || cyl || add) {
    return ' (SPH : ' + sph + ' CYL : ' + cyl + ' ADD : ' + add + ')';
  }
  return '';
}

function getLocalOptionsHtml() {
  var html = '<option value="">-- Pilih Barang di Gudang KL --</option>';
  Object.keys(barangMap).forEach(function (id) {
    var b = barangMap[id];
    var code = b.barcode_id ? (' (' + b.barcode_id + ')') : '';
    var rx = formatPrescription(b);
    html += '<option value="' + b.id + '" data-qty="' + b.qty + '">' +
      escapeHtml(b.nama_barang) + escapeHtml(rx) + code + ' (Stok: ' + b.qty + ')' +
      '</option>';
  });
  return html;
}

function getExternalOptionsHtml() {
  var html = '<option value="">-- Pilih Barang di Cabang Ketapang --</option>';
  if (!Array.isArray(externalItems)) {
    return html;
  }
  externalItems.forEach(function (item) {
    if (!item) return;
    var name = item.nama_barang || item.name || '';
    var code = item.barcode_id ? (' (' + item.barcode_id + ')') : '';
    var rx = formatPrescription(item);
    var cat = item.category || item.kategori_nama ? ' (' + (item.category || item.kategori_nama) + ')' : '';
    var stock = item.stock !== undefined ? item.stock : (item.qty !== undefined ? item.qty : 0);
    html += '<option value="' + escapeHtml(item.id) + '" data-stock="' + stock + '">' +
      escapeHtml(name) + escapeHtml(rx) + code + escapeHtml(cat) + ' - Stok: ' + stock +
      '</option>';
  });
  return html;
}

function loadExternalItems(callback) {
  $('#mitraStatusText').html('<span class="spinner-border spinner-border-sm me-1"></span>Memuat...');
  $.ajax({
    url: '/transfer-stock/external-items',
    method: 'GET',
    success: function (res) {
      var raw = (res && res.data) ? (res.data.items !== undefined ? res.data.items : res.data) : [];
      if (raw && !Array.isArray(raw) && Array.isArray(raw.items)) {
        raw = raw.items;
      }
      externalItems = Array.isArray(raw) ? raw : [];
      externalLoaded = true;

      if (res && res.success) {
        $('#mitraStatusText').html('<span class="text-success fw-semibold">Terhubung (' + externalItems.length + ' item)</span>');
      } else {
        $('#mitraStatusText').html('<span class="text-danger">Gagal</span>');
      }

      // Update any existing external dropdowns
      $('.item-external').each(function () {
        var curVal = $(this).val();
        $(this).html(getExternalOptionsHtml()).val(curVal).trigger('change');
      });

      if (callback) callback();
    },
    error: function () {
      externalItems = [];
      $('#mitraStatusText').html('<span class="text-danger">Gagal terhubung</span>');
      if (callback) callback();
    }
  });
}



function addItem() {
  var idx = itemIndex++;
  var html = '<div class="border rounded p-2 mb-2 item-row" data-idx="' + idx + '">' +
    '<div class="row g-2 align-items-start">' +
      '<div class="col-md-5">' +
        '<label class="form-label small mb-1">Barang (Gudang KL) <span class="text-danger">*</span></label>' +
        '<select class="form-select form-select-sm item-local" data-idx="' + idx + '">' +
          getLocalOptionsHtml() +
        '</select>' +
        '<div class="small mt-1 stock-info" data-idx="' + idx + '" style="font-size:0.75rem;"></div>' +
      '</div>' +
      '<div class="col-md-4">' +
        '<label class="form-label small mb-1">Barang (Cabang Ketapang) <span class="text-danger">*</span></label>' +
        '<select class="form-select form-select-sm item-external" data-idx="' + idx + '">' +
          getExternalOptionsHtml() +
        '</select>' +
      '</div>' +
      '<div class="col-md-2">' +
        '<label class="form-label small mb-1">Qty <span class="text-danger">*</span></label>' +
        '<input type="number" class="form-control form-control-sm item-qty calc-input" data-idx="' + idx + '" value="1" min="1">' +
      '</div>' +
      '<div class="col-md-1 d-flex align-items-end justify-content-end" style="height: 58px;">' +
        '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItem(' + idx + ')" title="Hapus baris">' +
          '<i class="bi bi-trash"></i>' +
        '</button>' +
      '</div>' +
    '</div>' +
  '</div>';

  $('#itemList').append(html);
  $('#emptyMsg').hide();

  var $local = $('.item-local[data-idx="' + idx + '"]');
  var $ext = $('.item-external[data-idx="' + idx + '"]');

  $local.select2({
    theme: 'bootstrap-5',
    placeholder: '-- Pilih Barang di Gudang KL --',
    allowClear: true
  }).on('select2:select', function () {
    updateStockInfo(idx);
    calcTotal();
  }).on('select2:unselect', function () {
    $('.stock-info[data-idx="' + idx + '"]').empty();
    calcTotal();
  });

  $ext.select2({
    theme: 'bootstrap-5',
    placeholder: '-- Pilih Barang di Cabang Ketapang --',
    allowClear: true
  });

  calcTotal();
}

function removeItem(idx) {
  $('.item-row[data-idx="' + idx + '"]').remove();
  if ($('.item-row').length === 0) {
    $('#emptyMsg').show();
  }
  calcTotal();
}

function updateStockInfo(idx) {
  var $row = $('.item-row[data-idx="' + idx + '"]');
  var $opt = $row.find('.item-local option:selected');
  var qty = $opt.data('qty');
  var $info = $row.find('.stock-info');

  if (qty !== undefined && $opt.val()) {
    var cls = qty <= 0 ? 'text-danger fw-bold' : 'text-success fw-bold';
    $info.html('Stok saat ini: <span class="' + cls + '">' + qty + ' pcs</span>');
  } else {
    $info.empty();
  }
}

function calcTotal() {
  var totalItems = 0;
  var totalPcs = 0;

  $('.item-row').each(function () {
    var localId = $(this).find('.item-local').val();
    var qty = parseInt($(this).find('.item-qty').val(), 10) || 0;
    if (localId && qty > 0) {
      totalItems++;
      totalPcs += qty;
    }
  });

  $('#totalDisplay').text(totalItems + ' Barang (' + totalPcs + ' Pcs)');
}

$(document).on('input', '.calc-input', function () {
  calcTotal();
});

function updateBarangStock(id, newQty) {
  if (barangMap[id]) {
    barangMap[id].qty = newQty;
  }
  $('.item-local').each(function () {
    var $opt = $(this).find('option[value="' + id + '"]');
    if ($opt.length) {
      $opt.data('qty', newQty);
      var t = $opt.text().replace(/\(Stok: -?\d+\)/, '(Stok: ' + newQty + ')');
      $opt.text(t);
    }
  });
}

function saveTransfer(btn) {
  var type = 'transfer';
  var notes = $('#notes').val().trim();
  var items = [];
  var hasInvalid = false;
  var stockError = '';

  var rows = $('.item-row');
  if (rows.length === 0) {
    showToast('Tambahkan minimal 1 item transfer', 'warning');
    return;
  }

  rows.each(function () {
    var localId = $(this).find('.item-local').val();
    var extId = $(this).find('.item-external').val();
    var qty = parseInt($(this).find('.item-qty').val(), 10) || 0;
    var stock = parseInt($(this).find('.item-local option:selected').data('qty'), 10);

    if (!localId && !extId && qty <= 0) {
      return;
    }

    if (!localId) {
      showToast('Pilih barang di Gudang KL untuk semua item', 'warning');
      hasInvalid = true;
      return false;
    }
    if (!extId) {
      showToast('Pilih barang di Cabang Ketapang untuk semua item', 'warning');
      hasInvalid = true;
      return false;
    }
    if (qty <= 0) {
      showToast('Jumlah (qty) harus lebih besar dari 0', 'warning');
      hasInvalid = true;
      return false;
    }

    if (qty > stock) {
      var name = $(this).find('.item-local option:selected').text();
      stockError = 'Stok tidak mencukupi untuk ' + name;
      hasInvalid = true;
      return false;
    }

    items.push({
      local_barang_id: parseInt(localId, 10),
      external_barang_id: extId,
      external_barang_nama: $(this).find('.item-external option:selected').text(),
      qty: qty
    });
  });

  if (hasInvalid) {
    if (stockError) showToast(stockError, 'danger');
    return;
  }

  if (items.length === 0) {
    showToast('Pilih barang dan jumlah transfer terlebih dahulu', 'warning');
    return;
  }

  if (!setBtnLoading(btn)) return;

  $.ajax({
    url: '/transfer-stock/execute',
    method: 'POST',
    contentType: 'application/json',
    data: JSON.stringify({
      type: type,
      notes: notes,
      items: items
    }),
    success: function (res) {
      resetBtn(btn);
      if (res.success) {
        showToast(res.data.message || 'Transfer berhasil disimpan!', 'success');

        if (res.data.results) {
          res.data.results.forEach(function (r) {
            updateBarangStock(r.local_barang_id, r.new_qty);
          });
        }

        // Add to session logs
        var logTime = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });

        var logHtml = '<div class="border-bottom pb-2 mb-2">' +
          '<div class="d-flex justify-content-between align-items-center">' +
            '<span class="badge bg-primary">Gudang KL → Cabang Ketapang</span>' +
            '<span class="text-muted font-monospace" style="font-size:0.75rem;">' + logTime + '</span>' +
          '</div>' +
          '<div class="fw-semibold mt-1">' + res.data.total_items + ' Barang (' + res.data.total_qty + ' Pcs)</div>' +
          (notes ? ('<div class="text-muted fst-italic" style="font-size:0.75rem;">"' + escapeHtml(notes) + '"</div>') : '') +
        '</div>';

        if (sessionLogs.length === 0) {
          $('#sessionLogs').empty();
        }
        sessionLogs.unshift(res.data);
        $('#sessionLogs').prepend(logHtml);
        $('#sessionCount').text(sessionLogs.length);

        // Reset inputs
        $('#notes').val('');
        $('#itemList').empty();
        itemIndex = 0;
        addItem();
        calcTotal();
      } else {
        showToast(res.message || 'Gagal menyimpan transfer', 'danger');
      }
    },
    error: function (xhr) {
      resetBtn(btn);
      var msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Terjadi kesalahan sistem';
      showToast(msg, 'danger');
    }
  });
}

$(function () {
  loadExternalItems(function () {
    if ($('.item-row').length === 0) {
      addItem();
    }
  });
});
</script>

<%- include('../partials/bottom') %>
