<% function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); } %>
<%- include('../partials/top', { title, activePage }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Daftar Pelunasan DP</h4>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="d-flex gap-2 align-items-center">
    <label class="mb-0 fw-bold">Filter:</label>
    <input type="date" id="filterStartDate" class="form-control form-control-sm" style="width:130px">
    <span>-</span>
    <input type="date" id="filterEndDate" class="form-control form-control-sm" style="width:130px">
    <button class="btn btn-sm btn-secondary" onclick="reloadTable()"><i class="bi bi-search"></i> Terapkan</button>
    <button class="btn btn-sm btn-outline-danger" onclick="resetFilter()"><i class="bi bi-x-circle"></i> Reset</button>
  </div>
</div>

<div class="row g-3 mb-4 row-cols-1 row-cols-md-4">
  <div class="col">
    <div class="stat-card">
      <i class="bi bi-cash-stack stat-icon text-success"></i>
      <div class="stat-value text-success" id="lblGrandTotal">Rp 0</div>
      <div class="stat-label">Total Pelunasan</div>
    </div>
  </div>
</div>

<div class="card p-3 shadow-sm border-0">
  <div class="table-responsive">
    <table id="tblPelunasanDp" class="table table-hover align-middle mb-0" style="width:100%">
      <thead class="table-light">
        <tr>
          <th>No. Nota</th>
          <th>Tgl Pelunasan</th>
          <th>Tgl Pembelian</th>
          <th>Nama Pelanggan</th>
          <th>Sales</th>
          <th class="text-end">Total Pembelian</th>
          <th class="text-end">Total DP</th>
          <th class="text-end">Total Pelunasan</th>
          <th class="text-center" style="width: 80px;">Aksi</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script>
  $(function () {
    function newExportAction(e, dt, button, config) {
      var self = this;
      var oldStart = dt.settings()[0]._iDisplayStart;
      dt.one('preXhr', function (e, s, data) {
        data.start = 0;
        data.length = -1;
        dt.one('preDraw', function (e, settings) {
          if (button[0].className.indexOf('buttons-excel') >= 0) {
            $.fn.dataTable.ext.buttons.excelHtml5.available(dt, config) ?
              $.fn.dataTable.ext.buttons.excelHtml5.action.call(self, e, dt, button, config) : null;
          } else if (button[0].className.indexOf('buttons-csv') >= 0) {
            $.fn.dataTable.ext.buttons.csvHtml5.available(dt, config) ?
              $.fn.dataTable.ext.buttons.csvHtml5.action.call(self, e, dt, button, config) : null;
          } else if (button[0].className.indexOf('buttons-print') >= 0) {
            $.fn.dataTable.ext.buttons.print.action.call(self, e, dt, button, config);
          }
          dt.one('preXhr', function (e, s, data) {
            settings._iDisplayStart = oldStart;
            data.start = oldStart;
          });
          setTimeout(dt.ajax.reload, 0);
          return false;
        });
      });
      dt.ajax.reload();
    }

    var table = $('#tblPelunasanDp').DataTable({
      serverSide: true,
      processing: true,
      drawCallback: function (settings) {
        var api = this.api();
        var json = api.ajax.json();
        if (json && json.grandTotal !== undefined) {
          $('#lblGrandTotal').text(fmtRp(json.grandTotal));
        }
      },
      ajax: {
        url: '/penjualan/pelunasan-dp/dt',
        data: function (d) {
          d.start_date = $('#filterStartDate').val();
          d.end_date = $('#filterEndDate').val();
        }
      },
      order: [[1, 'desc']], // Sort by Tgl Pelunasan by default
      lengthMenu: [[10, 50, 100, -1], [10, 50, 100, "All"]],
      layout: {
        topStart: {
          pageLength: {},
          buttons: {}
        },
        topEnd: 'search',
        bottomStart: 'info',
        bottomEnd: 'paging'
      },
      buttons: [
        {
          extend: 'excelHtml5',
          text: '<i class="bi bi-file-earmark-excel"></i> Excel',
          className: 'btn btn-success btn-sm',
          action: newExportAction,
          exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6], orthogonal: 'export' }
        },
        {
          extend: 'csvHtml5',
          text: '<i class="bi bi-filetype-csv"></i> CSV',
          className: 'btn btn-info btn-sm',
          action: newExportAction,
          exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6], orthogonal: 'export' }
        },
        {
          extend: 'print',
          text: '<i class="bi bi-printer"></i> Print',
          className: 'btn btn-secondary btn-sm',
          exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6], orthogonal: 'export' }
        }
      ],
      columns: [
        {
          data: 'no_nota',
          render: function (data) { return '<span class="badge bg-secondary">' + escapeHtml(data) + '</span>'; }
        },
        {
          data: 'tanggal_pelunasan',
          render: function (data) { return data ? new Date(data).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '-'; }
        },
        {
          data: 'order_date',
          render: function (data) { return data ? new Date(data).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '-'; }
        },
        {
          data: 'pelanggan_nama',
          render: function (data) { return escapeHtml(data || '-'); }
        },
        {
          data: 'sales_nama',
          render: function (data) { return escapeHtml(data || '-'); }
        },
        {
          data: 'total',
          className: 'text-end fw-bold',
          render: function (data) { return fmtRp(data); }
        },
        {
          data: 'dp',
          className: 'text-end fw-bold text-warning',
          render: function (data) { return fmtRp(data); }
        },
        {
          data: 'total_bayar',
          className: 'text-end text-success fw-bold',
          render: function (data) { return fmtRp(data); }
        },
        {
          data: null,
          orderable: false,
          className: 'text-center',
          render: function (data, type, row) {
            return '<a href="/penjualan/' + row.id + '" class="btn btn-sm btn-outline-info" onclick="showDetail(event, ' + row.id + ')" title="Lihat Detail"><i class="bi bi-eye"></i></a>';
          }
        }
      ],
      language: dtLanguageID
    });
  });

  function reloadTable() {
    $('#tblPelunasanDp').DataTable().ajax.reload();
  }

  function resetFilter() {
    $('#filterStartDate').val('');
    $('#filterEndDate').val('');
    $('#tblPelunasanDp').DataTable().ajax.reload();
  }

  function fmtRp(v) { return 'Rp ' + Number(v || 0).toLocaleString('id-ID'); }

  function showDetail(e, id) {
    e.preventDefault();
    var myModal = new bootstrap.Modal(document.getElementById('detailModal'));
    myModal.show();
    $('#detailBody').html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Memuat data...</p></div>');

    $.get('/penjualan/' + id, function (res) {
      if (!res.success) {
        $('#detailBody').html('<div class="alert alert-danger m-3">Gagal memuat detail.</div>');
        return;
      }
      var d = res.data;

      var html = '<div class="p-3">';
      
      // Riwayat Pembayaran
      if (d.pembayaran && d.pembayaran.length > 0) {
        html += '<h6 class="fw-bold mb-3 border-bottom pb-2">Riwayat Pembayaran</h6>';
        html += '<div class="table-responsive"><table class="table table-sm table-bordered">';
        html += '<thead class="bg-light"><tr><th>Tanggal</th><th>Metode</th><th>Keterangan</th><th class="text-end">Jumlah Bayar</th></tr></thead><tbody>';
        var totalBayar = 0;
        d.pembayaran.forEach(function (p) {
          totalBayar += parseFloat(p.jumlah_bayar || 0);
          var tgl = p.tanggal_bayar ? new Date(p.tanggal_bayar).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '-';
          html += '<tr>';
          html += '<td>' + tgl + '</td>';
          html += '<td>' + escapeHtml(p.metode_pembayaran_nama || '-') + '</td>';
          html += '<td>' + escapeHtml(p.keterangan || '-') + '</td>';
          html += '<td class="text-end text-success fw-bold">' + fmtRp(p.jumlah_bayar) + '</td>';
          html += '</tr>';
        });
        html += '<tr class="bg-light fw-bold"><td colspan="3" class="text-end">Total Pembayaran</td><td class="text-end text-success">' + fmtRp(totalBayar) + '</td></tr>';
        html += '</tbody></table></div>';
      }

      // Rincian Barang
      html += '<h6 class="fw-bold mt-4 mb-3 border-bottom pb-2">Detail Barang</h6>';
      html += '<div class="table-responsive"><table class="table table-sm table-bordered"><thead><tr class="bg-light"><th>Barang</th><th>Barcode</th><th class="text-center">Qty</th><th class="text-end">Harga</th><th class="text-end">Subtotal</th></tr></thead><tbody>';
      d.detail.forEach(function (item) {
        var itemName = item.nama_barang || item.keterangan || item.barang_nama || '-';
        var sph = item.b_sph_r || item.b_sph_l || '';
        var cyl = item.b_cyl_r || item.b_cyl_l || '';
        var add = item.b_add_r || item.b_add_l || '';
        if (sph || cyl || add) {
          itemName += ' <span class="text-muted small">(SPH : ' + sph + ' CYL : ' + cyl + ' ADD : ' + add + ')</span>';
        }
        var categoryName = item.kategori_nama ? ' <span class="badge bg-info bg-opacity-25 text-info">' + item.kategori_nama + '</span>' : '';

        html += '<tr>';
        html += '<td>' + itemName + categoryName + '</td>';
        html += '<td class="font-monospace text-muted">' + (item.barcode_id || '-') + '</td>';
        html += '<td class="text-center">' + (item.jumlah || 0) + '</td>';
        html += '<td class="text-end">' + fmtRp(item.harga) + '</td>';
        html += '<td class="text-end">' + fmtRp((item.harga || 0) * (item.jumlah || 0)) + '</td>';
        html += '</tr>';
      });
      html += '</tbody></table></div>';

      // Rincian Resep
      var hasResepR = d.sph_r || d.cyl_r || d.axis_r || d.add_r;
      var hasResepL = d.sph_l || d.cyl_l || d.axis_l || d.add_l;

      if (hasResepR || hasResepL || d.pd) {
        html += '<h6 class="fw-bold mt-4 mb-3 border-bottom pb-2">Resep Kacamata</h6>';
        html += '<div class="table-responsive"><table class="table table-sm table-bordered text-center align-middle">';
        html += '<thead class="bg-light"><tr><th>Mata</th><th>SPH</th><th>CYL</th><th>AXIS</th><th>ADD</th></tr></thead><tbody>';
        if (hasResepR) {
          html += '<tr><td class="bg-light"><strong>Kanan (R)</strong></td>';
          html += '<td>' + (d.sph_r || '-') + '</td>';
          html += '<td>' + (d.cyl_r || '-') + '</td>';
          html += '<td>' + (d.axis_r || '-') + '</td>';
          html += '<td>' + (d.add_r || '-') + '</td></tr>';
        }
        if (hasResepL) {
          html += '<tr><td class="bg-light"><strong>Kiri (L)</strong></td>';
          html += '<td>' + (d.sph_l || '-') + '</td>';
          html += '<td>' + (d.cyl_l || '-') + '</td>';
          html += '<td>' + (d.axis_l || '-') + '</td>';
          html += '<td>' + (d.add_l || '-') + '</td></tr>';
        }
        html += '</tbody></table></div>';
        
        if (d.pd) {
          html += '<p class="mt-2 mb-0"><span class="badge bg-secondary">PD: ' + d.pd + '</span></p>';
        }
      }
      

      html += '</div>';
      $('#detailBody').html(html);
    }).fail(function () {
      $('#detailBody').html('<div class="alert alert-danger m-3">Terjadi kesalahan saat memuat data.</div>');
    });
  }
</script>

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold text-primary"><i class="bi bi-receipt me-2"></i>Detail Transaksi</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0" id="detailBody">
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/bottom') %>
