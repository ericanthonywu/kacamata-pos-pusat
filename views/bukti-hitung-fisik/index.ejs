<% function fmtDate(d) { return d ? new Date(d).toLocaleDateString('id-ID', { day: '2-digit' , month: '2-digit' ,
  year: 'numeric' , hour: '2-digit' , minute: '2-digit' }) : '-' ; } %>
  <%- include('../partials/top', { title, activePage }) %>
    <%- include('../partials/select2') %>

      <div class="row g-2 mb-3 align-items-end">
        <div class="col-auto">
          <label class="form-label small">Dari</label>
          <input type="date" id="filterFrom" class="form-control form-control-sm" value="<%= filters.from || '' %>">
        </div>
        <div class="col-auto">
          <label class="form-label small">Sampai</label>
          <input type="date" id="filterTo" class="form-control form-control-sm" value="<%= filters.to || '' %>">
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-primary btn-sm" id="btnFilter"><i class="bi bi-search"></i>
            Tampilkan</button>
          <button type="button" class="btn btn-outline-danger btn-sm" id="btnReset"><i class="bi bi-x-circle"></i>
            Reset</button>
        </div>
        <div class="col-auto ms-auto">
          <button class="btn btn-primary btn-sm" id="btnAdd"><i class="bi bi-plus"></i> Tambah</button>
        </div>
      </div>

      <div class="card p-3">
        <table id="tblBhf" class="table table-hover mb-0" style="width:100%">
          <thead>
            <tr>
              <th>Nama Barang</th>
              <th>Barcode</th>
              <th>Qty Sebelum</th>
              <th>Qty Sesudah</th>
              <th>Selisih</th>
              <th>Diubah Oleh</th>
              <th>Tanggal</th>
              <th style="width:80px">Aksi</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </div>


      <!-- Bulk Form Modal -->
      <div class="modal fade" id="bulkModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Hitung Fisik</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" id="bulkTable">
                  <thead>
                    <tr>
                      <th style="width:40px">#</th>
                      <th>Barang</th>
                      <th style="width:120px">Qty Sebelum</th>
                      <th style="width:120px">Qty Sesudah</th>
                      <th style="width:100px">Selisih</th>
                      <th style="width:50px"></th>
                    </tr>
                  </thead>
                  <tbody id="bulkRows">
                  </tbody>
                </table>
              </div>
              <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="btnAddRow">
                <i class="bi bi-plus-circle"></i> Tambah Baris
              </button>
            </div>
            <div class="modal-footer">
              <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
              <button class="btn btn-primary btn-sm" id="btnSaveBulk">
                <i class="bi bi-check-circle"></i> Simpan Semua
              </button>
            </div>
          </div>
        </div>
      </div>

      <script>
        window.userRole = '<%= currentUser.hak_akses %>';
        $(function () {
          function newExportAction(e, dt, button, config) {
            var self = this;
            var oldStart = dt.settings()[0]._iDisplayStart;
            dt.one('preXhr', function (e, s, data) {
              data.start = 0;
              data.length = -1;
              dt.one('preDraw', function (e, settings) {
                if (button[0].className.indexOf('buttons-excel') >= 0) {
                  $.fn.dataTable.ext.buttons.excelHtml5.available(dt, config) ?
                    $.fn.dataTable.ext.buttons.excelHtml5.action.call(self, e, dt, button, config) : null;
                } else if (button[0].className.indexOf('buttons-csv') >= 0) {
                  $.fn.dataTable.ext.buttons.csvHtml5.available(dt, config) ?
                    $.fn.dataTable.ext.buttons.csvHtml5.action.call(self, e, dt, button, config) : null;
                }
                dt.one('preXhr', function (e, s, data) {
                  settings._iDisplayStart = oldStart;
                  data.start = oldStart;
                });
                setTimeout(dt.ajax.reload, 0);
                return false;
              });
            });
            dt.ajax.reload();
          }

          var dt = $('#tblBhf').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
              url: '/bukti-hitung-fisik/dt',
              data: function (d) {
                d.from = $('#filterFrom').val();
                d.to = $('#filterTo').val();
              }
            },
            order: [[6, 'desc']],
            lengthMenu: [[10, 50, 100, -1], [10, 50, 100, "All"]],
            layout: {
              topStart: {
                pageLength: {},
                buttons: {}
              },
              topEnd: 'search',
              bottomStart: 'info',
              bottomEnd: 'paging'
            },
            buttons: [
              {
                extend: 'excelHtml5',
                text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                className: 'btn btn-success btn-sm',
                action: newExportAction,
                exportOptions: { columns: ':visible:not(:last-child)', orthogonal: 'export' }
              },
              {
                extend: 'csvHtml5',
                text: '<i class="bi bi-filetype-csv"></i> CSV',
                className: 'btn btn-info btn-sm',
                action: newExportAction,
                exportOptions: { columns: ':visible:not(:last-child)', orthogonal: 'export' }
              },
              {
                extend: 'print',
                text: '<i class="bi bi-printer"></i> Print',
                className: 'btn btn-secondary btn-sm',
                exportOptions: { columns: ':visible:not(:last-child)', orthogonal: 'export' }
              }
            ],
            language: dtLanguageID,
            columns: [
              {
                data: 'nama_barang',
                render: function (d, type, row) {
                  if (type !== 'display' && type !== 'filter') return d;
                  var sph = row.sph_r || row.sph_l || '';
                  var cyl = row.cyl_r || row.cyl_l || '';
                  var add = row.add_r || row.add_l || '';
                  var ukuran = '';
                  if (sph || cyl || add) {
                    ukuran = ' <span class="text-muted small">(SPH: ' + sph + ' CYL: ' + cyl + (add ? ' ADD: ' + add : '') + ')</span>';
                  }
                  return d + ukuran;
                }
              },
              { data: 'barcode_id', render: function (d) { return '<span class="font-monospace small">' + (d || '-') + '</span>'; } },
              { data: 'qty_sebelum' },
              { data: 'qty_sesudah' },
              {
                data: 'selisih', render: function (d) {
                  if (d > 0) return '<span class="text-success fw-bold">+' + d + '</span>';
                  if (d < 0) return '<span class="text-danger fw-bold">' + d + '</span>';
                  return '<span class="text-muted">0</span>';
                }
              },
              { data: 'diubah_oleh' },
              {
                data: 'created_at', render: function (d) {
                  if (!d) return '-';
                  var dt = new Date(d);
                  var dd = String(dt.getDate()).padStart(2, '0');
                  var mm = String(dt.getMonth() + 1).padStart(2, '0');
                  var yy = dt.getFullYear();
                  var hh = String(dt.getHours()).padStart(2, '0');
                  var mi = String(dt.getMinutes()).padStart(2, '0');
                  return dd + '/' + mm + '/' + yy + ' ' + hh + ':' + mi;
                }
              },
              {
                data: 'id', orderable: false, render: function (d) {
                  if (window.userRole === 'admin') {
                    return '<button class="btn btn-sm btn-outline-danger btn-del" data-id="' + d + '" data-url="/bukti-hitung-fisik/' + d + '"><i class="bi bi-trash"></i></button>';
                  }
                  return '';
                }
              }
            ]
          });

          // Filter
          $('#btnFilter').on('click', function () { dt.ajax.reload(); });
          $('#btnReset').on('click', function () {
            $('#filterFrom').val('');
            $('#filterTo').val('');
            dt.ajax.reload();
          });



          // Delete
          $(document).on('click', '.btn-del', function () {
            confirmDelete($(this).data('id'), $(this).data('url'));
          });

          // ─── Bulk Form Modal ───────────────────────────────────
          var bulkModal = new bootstrap.Modal(document.getElementById('bulkModal'));
          var bulkRowIdx = 0;

          function buildBarangLabel(item) {
            var text = item.nama_barang;
            var sph = item.sph_r || item.sph_l || '';
            var cyl = item.cyl_r || item.cyl_l || '';
            var add = item.add_r || item.add_l || '';
            if (sph || cyl || add) {
              text += ' (SPH: ' + sph + ' CYL: ' + cyl + ' ADD: ' + add + ')';
            }
            text += ' [Stok: ' + item.qty + ']';
            return text;
          }

          function addBulkRow() {
            bulkRowIdx++;
            var idx = bulkRowIdx;
            var html = '<tr data-idx="' + idx + '">' +
              '<td class="text-center fw-bold">' + idx + '</td>' +
              '<td><select class="form-select bulk-barang" data-idx="' + idx + '" style="width:100%"></select></td>' +
              '<td><input type="text" class="form-control form-control-sm bulk-sebelum" data-idx="' + idx + '" readonly></td>' +
              '<td><input type="number" class="form-control form-control-sm bulk-sesudah" data-idx="' + idx + '" placeholder="Qty baru"></td>' +
              '<td class="bulk-selisih" data-idx="' + idx + '"><span class="text-muted">-</span></td>' +
              '<td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row" data-idx="' + idx + '"><i class="bi bi-x"></i></button></td>' +
              '</tr>';
            $('#bulkRows').append(html);

            // Init Select2 on the new row
            var $sel = $('select.bulk-barang[data-idx="' + idx + '"]');
            $sel.select2({
              theme: 'bootstrap-5',
              placeholder: '-- Cari Barang --',
              allowClear: true,
              dropdownParent: $('#bulkModal'),
              ajax: {
                url: '/barang/search',
                dataType: 'json',
                delay: 250,
                data: function (params) { return { q: params.term || '' }; },
                processResults: function (data) {
                  return {
                    results: $.map(data.data, function (item) {
                      return { id: item.id, text: buildBarangLabel(item), item: item };
                    })
                  };
                },
                cache: true
              }
            }).on('select2:select', function (e) {
              var b = e.params.data.item;
              var i = $(this).data('idx');
              $('input.bulk-sebelum[data-idx="' + i + '"]').val(b.qty);
              $('input.bulk-sesudah[data-idx="' + i + '"]').val('').focus();
              $('td.bulk-selisih[data-idx="' + i + '"]').html('<span class="text-muted">-</span>');
            }).on('select2:clear', function () {
              var i = $(this).data('idx');
              $('input.bulk-sebelum[data-idx="' + i + '"]').val('');
              $('input.bulk-sesudah[data-idx="' + i + '"]').val('');
              $('td.bulk-selisih[data-idx="' + i + '"]').html('<span class="text-muted">-</span>');
            });

            return idx;
          }

          function renumberBulkRows() {
            $('#bulkRows tr').each(function (i) {
              $(this).find('td:first').text(i + 1);
            });
          }

          // Selisih preview for bulk rows
          $(document).on('input', '.bulk-sesudah', function () {
            var i = $(this).data('idx');
            var sebelum = parseInt($('input.bulk-sebelum[data-idx="' + i + '"]').val()) || 0;
            var sesudah = parseInt($(this).val());
            var $td = $('td.bulk-selisih[data-idx="' + i + '"]');
            if (!isNaN(sesudah)) {
              var selisih = sesudah - sebelum;
              var text = selisih > 0 ? '+' + selisih : String(selisih);
              var cls = selisih > 0 ? 'text-success fw-bold' : (selisih < 0 ? 'text-danger fw-bold' : 'text-muted');
              $td.html('<span class="' + cls + '">' + text + '</span>');
            } else {
              $td.html('<span class="text-muted">-</span>');
            }
          });

          // Remove row
          $(document).on('click', '.btn-remove-row', function () {
            var i = $(this).data('idx');
            // Destroy Select2 before removing
            $('select.bulk-barang[data-idx="' + i + '"]').select2('destroy');
            $('tr[data-idx="' + i + '"]').remove();
            renumberBulkRows();
          });

          // Add row button
          $('#btnAddRow').on('click', function () { addBulkRow(); });

          // Open bulk modal
          $('#btnAdd').on('click', function () {
            // Clear existing rows
            $('#bulkRows').empty();
            bulkRowIdx = 0;
            // Start with 3 empty rows
            addBulkRow();
            addBulkRow();
            addBulkRow();
            bulkModal.show();
          });

          // Save bulk
          $('#btnSaveBulk').on('click', function () {
            var btn = this;
            if (!setBtnLoading(btn)) return;

            var items = [];
            var valid = true;
            $('#bulkRows tr').each(function () {
              var idx = $(this).data('idx');
              var barangId = $('select.bulk-barang[data-idx="' + idx + '"]').val();
              var qtySesudah = $('input.bulk-sesudah[data-idx="' + idx + '"]').val();

              // Skip completely empty rows
              if (!barangId && (qtySesudah === '' || qtySesudah === null)) return;

              if (!barangId) {
                showToast('Baris ' + $(this).find('td:first').text() + ': Pilih barang terlebih dahulu', 'warning');
                valid = false;
                return false;
              }
              if (qtySesudah === '' || isNaN(parseInt(qtySesudah))) {
                showToast('Baris ' + $(this).find('td:first').text() + ': Qty sesudah harus diisi', 'warning');
                valid = false;
                return false;
              }

              items.push({ barang_id: barangId, qty_sesudah: qtySesudah });
            });

            if (!valid) { resetBtn(btn); return; }
            if (items.length === 0) {
              showToast('Minimal satu baris harus diisi', 'warning');
              resetBtn(btn);
              return;
            }

            $.ajax({
              url: '/bukti-hitung-fisik/bulk',
              method: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({ items: items }),
              success: function (res) {
                if (res.success) {
                  bulkModal.hide();
                  showToast(items.length + ' bukti hitung fisik berhasil disimpan', 'success');
                  dt.ajax.reload();
                }
                resetBtn(btn);
              },
              error: function (xhr) {
                showToast((xhr.responseJSON && xhr.responseJSON.message) || 'Gagal menyimpan', 'danger');
                resetBtn(btn);
              }
            });
          });
        });
      </script>

      <%- include('../partials/bottom') %>