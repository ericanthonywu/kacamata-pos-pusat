<% const bp = typeof basePath !== 'undefined' ? basePath : ''; %>
<% const isAdmin = currentUser && currentUser.hak_akses === 'admin'; %>
<% const isGudang = currentUser && currentUser.hak_akses === 'gudang'; %>
<nav class="sidebar">
  <div class="sidebar-brand">
    <i class="bi bi-eyeglasses"></i>
    <span>Optik Kacamata Lensa</span>
  </div>

  <div class="sidebar-menu-container">
    <% if (isGudang) { %>
    <%# Gudang role: only show Stock Gudang %>
    <div class="sidebar-section">
      <div class="sidebar-label">Stok</div>
      <a href="<%= bp %>/stock-gudang" class="sidebar-link <%= activePage === 'stock-gudang' ? 'active' : '' %>">
        <i class="bi bi-house-gear"></i> Stock Gudang
      </a>
    </div>
    <% } else { %>
    <div class="sidebar-section">
    <div class="sidebar-label">Menu Utama</div>
    <a href="<%= bp %>/" class="sidebar-link <%= activePage === 'dashboard' ? 'active' : '' %>">
      <i class="bi bi-grid-1x2"></i> Dashboard
    </a>
    <a href="<%= bp %>/penjualan" class="sidebar-link <%= activePage === 'penjualan' ? 'active' : '' %>">
      <i class="bi bi-receipt"></i> Data Penjualan
    </a>
    <a href="<%= bp %>/penjualan/baru" class="sidebar-link <%= activePage === 'penjualan-baru' ? 'active' : '' %>">
      <i class="bi bi-plus-square"></i> Tambah Penjualan
    </a>
    <a href="<%= bp %>/penjualan/toko" class="sidebar-link <%= activePage === 'penjualan-toko' ? 'active' : '' %>">
      <i class="bi bi-shop"></i> Penjualan Toko (B2B)
    </a>
    <a href="<%= bp %>/pembelian" class="sidebar-link <%= activePage === 'pembelian' ? 'active' : '' %>">
      <i class="bi bi-cart-plus"></i> Pembelian
    </a>
    <a href="<%= bp %>/laporan/kas" class="sidebar-link <%= activePage === 'laporan-kas' ? 'active' : '' %>">
      <i class="bi bi-graph-up"></i> Laporan Kas
    </a>
    <% if (isAdmin) { %>
    <a href="<%= bp %>/laporan/komisi" class="sidebar-link <%= activePage === 'laporan-komisi' ? 'active' : '' %>">
      <i class="bi bi-award"></i> Laporan Komisi
    </a>
    <a href="<%= bp %>/laporan/margin" class="sidebar-link <%= activePage === 'laporan-margin' ? 'active' : '' %>">
      <i class="bi bi-percent"></i> Analisis Margin
    </a>
    <% } %>
  </div>

  <% if (isAdmin) { %>
  <div class="sidebar-section">
    <div class="sidebar-label">Retur</div>
    <a href="<%= bp %>/penjualan-retur" class="sidebar-link <%= activePage === 'penjualan-retur' ? 'active' : '' %>">
      <i class="bi bi-arrow-return-left"></i> Retur Penjualan
    </a>
    <a href="<%= bp %>/pembelian-retur" class="sidebar-link <%= activePage === 'pembelian-retur' ? 'active' : '' %>">
      <i class="bi bi-arrow-return-right"></i> Retur Pembelian
    </a>
  </div>
  <% } %>

  <div class="sidebar-section">
    <div class="sidebar-label">Hutang / Piutang</div>
    <% if (isAdmin) { %>
    <a href="<%= bp %>/pembayaran-pembelian" class="sidebar-link <%= activePage === 'hutang-pembelian' ? 'active' : '' %>">
      <i class="bi bi-wallet2"></i> Hutang Pembelian
    </a>
    <% } %>
    <a href="<%= bp %>/pembayaran-penjualan" class="sidebar-link <%= activePage === 'hutang-penjualan' ? 'active' : '' %>">
      <i class="bi bi-cash-coin"></i> Hutang Penjualan
    </a>
    <a href="<%= bp %>/penjualan/pelunasan-dp" class="sidebar-link <%= activePage === 'pelunasan_dp' ? 'active' : '' %>">
      <i class="bi bi-check-circle"></i> Pelunasan DP
    </a>
  </div>

  <div class="sidebar-section">
    <div class="sidebar-label">Stok</div>
    <a href="<%= bp %>/stock-gudang" class="sidebar-link <%= activePage === 'stock-gudang' ? 'active' : '' %>">
      <i class="bi bi-house-gear"></i> Stock Gudang
    </a>
    <% if (isAdmin) { %>
    <a href="<%= bp %>/transfer-stock" class="sidebar-link <%= activePage === 'transfer-stock' ? 'active' : '' %>">
      <i class="bi bi-arrow-left-right"></i> Transfer Stock
    </a>
    <% } %>
  </div>

  <div class="sidebar-section">
    <div class="sidebar-label">Master Data</div>
    <% if (isAdmin) { %>
    <a href="<%= bp %>/kategori" class="sidebar-link <%= activePage === 'kategori' ? 'active' : '' %>">
      <i class="bi bi-folder"></i> Kategori
    </a>
    <% } %>
    <a href="<%= bp %>/barang" class="sidebar-link <%= activePage === 'barang' ? 'active' : '' %>">
      <i class="bi bi-box-seam"></i> Barang
    </a>
    <a href="<%= bp %>/metode-pembayaran" class="sidebar-link <%= activePage === 'metode-pembayaran' ? 'active' : '' %>">
      <i class="bi bi-credit-card"></i> Metode Pembayaran
    </a>
    <a href="<%= bp %>/bukti-hitung-fisik" class="sidebar-link <%= activePage === 'bukti-hitung-fisik' ? 'active' : '' %>">
      <i class="bi bi-journal-check"></i> Bukti Hitung Fisik
    </a>
    <% if (isAdmin) { %>
    <a href="<%= bp %>/supplier" class="sidebar-link <%= activePage === 'supplier' ? 'active' : '' %>">
      <i class="bi bi-truck"></i> Supplier
    </a>
    <% } %>
    <a href="<%= bp %>/pelanggan" class="sidebar-link <%= activePage === 'pelanggan' ? 'active' : '' %>">
      <i class="bi bi-people"></i> Pelanggan
    </a>
    <% if (isAdmin) { %>
    <a href="<%= bp %>/sales" class="sidebar-link <%= activePage === 'sales' ? 'active' : '' %>">
      <i class="bi bi-person-badge"></i> Sales
    </a>
    <% } %>
  </div>

  <% if (isAdmin) { %>
  <div class="sidebar-section">
    <div class="sidebar-label">Pengaturan</div>
    <a href="<%= bp %>/pengguna" class="sidebar-link <%= activePage === 'pengguna' ? 'active' : '' %>">
      <i class="bi bi-gear"></i> Pengguna
    </a>
  </div>
  <% } %>

  <% if (currentUser && isAdmin) { %>
  <div class="sidebar-section">
    <div class="sidebar-label">Akses Cabang Lain</div>
    <% if (bp === '/pontianak') { %>
    <a href="/ketapang/" class="sidebar-link text-warning">
      <i class="bi bi-shop"></i> Cabang Ketapang &rarr;
    </a>
    <% } else { %>
    <a href="/pontianak/" class="sidebar-link text-info">
      <i class="bi bi-building"></i> Pusat Pontianak &rarr;
    </a>
    <% } %>
  </div>
  <% } %>
  <% } %>
  </div>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="user-avatar">
        <%= (currentUser && currentUser.nama) ? currentUser.nama.charAt(0).toUpperCase() : 'U' %>
      </div>
      <div class="user-info">
        <div class="user-name">
          <%= (currentUser && currentUser.nama) ? currentUser.nama : 'User' %>
        </div>
        <div class="user-role">
          <%= (currentUser && currentUser.hak_akses) ? currentUser.hak_akses : '-' %>
        </div>
      </div>
      <a href="<%= bp %>/logout" class="btn btn-sm btn-outline-secondary ms-auto" title="Logout">
        <i class="bi bi-box-arrow-right"></i>
      </a>
    </div>
  </div>
</nav>