<!DOCTYPE html>
<html lang="id" data-bs-theme="light">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — OPTIK KACAMATA LENSA</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="<%= typeof basePath !== 'undefined' ? basePath : '' %>/css/app.css?v=3" rel="stylesheet">
  <script>window.__APP_PREFIX__ = "<%= typeof basePath !== 'undefined' ? basePath : '' %>";</script>
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
  <script src="<%= typeof basePath !== 'undefined' ? basePath : '' %>/js/app.js"></script>
</head>

<body class="login-page">
  <div class="login-container">
    <div class="login-card">
      <div class="text-center mb-4">
        <div class="login-logo">👓</div>
        <h3 class="fw-bold">OPTIK KACAMATA LENSA</h3>
        <p class="text-muted small">Masuk ke panel admin</p>
      </div>
      <% if (error) { %>
        <div class="alert alert-danger py-2 small">
          <%= error %>
        </div>
        <% } %>
          <form method="POST" action="<%= typeof basePath !== 'undefined' ? basePath : '' %>/login">
            <div class="mb-3">
              <label class="form-label small">Username</label>
              <input type="text" name="username" class="form-control" placeholder="Masukkan username" autofocus
                required>
            </div>
            <div class="mb-3">
              <label class="form-label small">Password</label>
              <input type="password" name="password" class="form-control" placeholder="Masukkan password" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Masuk</button>
          </form>
    </div>
  </div>
</body>

</html>