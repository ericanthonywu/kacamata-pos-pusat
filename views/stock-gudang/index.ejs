<%- include('../partials/top', { title, activePage }) %>

  <div class="row g-2 align-items-center mb-3">
    <div class="col-auto"><label class="form-label small fw-bold mb-0">Filter Kategori:</label></div>
    <div class="col-md-3">
      <select class="form-select form-select-sm" id="filterKategori">
        <option value="">Semua Kategori</option>
        <% kategoriList.forEach(function(k) { %>
          <option value="<%= k.id %>">
            <%= k.nama %>
          </option>
          <% }); %>
      </select>
    </div>
    <div class="col-auto">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" id="filterMinus" role="switch">
        <label class="form-check-label small" for="filterMinus">Stok Minus Saja</label>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4 col-4">
      <div class="stat-card"><i class="bi bi-box-seam stat-icon text-info"></i>
        <div class="stat-value" id="valJenis">0</div>
        <div class="stat-label">Jenis Barang</div>
      </div>
    </div>
    <div class="col-md-4 col-4">
      <div class="stat-card"><i class="bi bi-layers stat-icon text-success"></i>
        <div class="stat-value" id="valStock">0</div>
        <div class="stat-label">Total Stock</div>
      </div>
    </div>
    <div class="col-md-4 col-4">
      <div class="stat-card" id="cardMinus" style="cursor:pointer" title="Klik untuk filter stok minus">
        <i class="bi bi-exclamation-triangle stat-icon text-danger"></i>
        <div class="stat-value text-danger" id="valHabis">0</div>
        <div class="stat-label">Stok Minus (&lt; 0)</div>
      </div>
    </div>
  </div>

  <div class="card p-3">
    <table id="tblStock" class="table table-hover mb-0" style="width:100%">
      <thead>
        <tr>
          <th>Nama Barang</th>
          <th>Kategori</th>
          <th>Barcode</th>
          <th>Qty</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <!-- Data akan diload via AJAX -->
      </tbody>
    </table>
  </div>

  <script>
$(function() { 
  function newExportAction(e, dt, button, config) {
    var self = this;
    var oldStart = dt.settings()[0]._iDisplayStart;
    dt.one('preXhr', function (e, s, data) {
      data.start = 0;
      data.length = -1;
      dt.one('preDraw', function (e, settings) {
        if (button[0].className.indexOf('buttons-excel') >= 0) {
          $.fn.dataTable.ext.buttons.excelHtml5.available(dt, config) ?
            $.fn.dataTable.ext.buttons.excelHtml5.action.call(self, e, dt, button, config) : null;
        } else if (button[0].className.indexOf('buttons-csv') >= 0) {
          $.fn.dataTable.ext.buttons.csvHtml5.available(dt, config) ?
            $.fn.dataTable.ext.buttons.csvHtml5.action.call(self, e, dt, button, config) : null;
        } else if (button[0].className.indexOf('buttons-print') >= 0) {
          $.fn.dataTable.ext.buttons.print.action.call(self, e, dt, button, config);
        }
        dt.one('preXhr', function (e, s, data) {
          settings._iDisplayStart = oldStart;
          data.start = oldStart;
        });
        setTimeout(dt.ajax.reload, 0);
        return false;
      });
    });
    dt.ajax.reload();
  }

  var table = $('#tblStock').DataTable({ 
    processing: true,
    serverSide: true,
    ajax: {
      url: '/barang/dt',
      data: function(d) {
        d.kategori_id = $('#filterKategori').val();
        d.minus_stock = $('#filterMinus').is(':checked') ? '1' : '';
      }
    },
    order: [[3, 'asc']], 
    language: dtLanguageID,
    lengthMenu: [[10, 50, 100, -1], [10, 50, 100, "All"]],
    layout: {
      topStart: {
        pageLength: {},
        buttons: {}
      },
      topEnd: 'search',
      bottomStart: 'info',
      bottomEnd: 'paging'
    },
    buttons: [
      {
        extend: 'excelHtml5',
        text: '<i class="bi bi-file-earmark-excel"></i> Excel',
        className: 'btn btn-success btn-sm',
        action: newExportAction,
        exportOptions: { columns: [0, 1, 2, 3, 4], orthogonal: 'export' }
      },
      {
        extend: 'csvHtml5',
        text: '<i class="bi bi-filetype-csv"></i> CSV',
        className: 'btn btn-info btn-sm',
        action: newExportAction,
        exportOptions: { columns: [0, 1, 2, 3, 4], orthogonal: 'export' }
      },
      {
        extend: 'print',
        text: '<i class="bi bi-printer"></i> Print',
        className: 'btn btn-secondary btn-sm',
        exportOptions: { columns: [0, 1, 2, 3, 4], orthogonal: 'export' }
      }
    ],
    columns: [
      { data: 'nama_barang', render: function(d, type, row) {
          var t = d;
          var sph = row.sph_r || row.sph_l || '';
          var cyl = row.cyl_r || row.cyl_l || '';
          var add = row.add_r || row.add_l || '';
          if (sph || cyl || add) {
            t += ' <span class="text-muted small">(SPH : ' + sph + ' CYL : ' + cyl + ' ADD : ' + add + ')</span>';
          }
          return t;
      } },
      { data: 'kategori_nama', render: function(d) { return '<span class="badge bg-info bg-opacity-25 text-info">' + (d||'-') + '</span>'; } },
      { data: 'barcode_id', render: function(d) { return '<span class="font-monospace small">' + (d||'-') + '</span>'; } },
      { data: 'qty', render: function(d) { 
          var cls = '';
          if (d <= 0) cls = 'text-danger';
          else if (d <= 5) cls = 'text-warning text-dark';
          return '<span class="fw-bold ' + cls + '">' + d + '</span>'; 
      } },
      { data: 'qty', orderable: false, render: function(d) {
          if (d <= 0) return '<span class="badge bg-danger">Habis</span>';
          if (d <= 5) return '<span class="badge bg-warning text-dark">Rendah</span>';
          return '<span class="badge bg-success">Tersedia</span>';
      } }
    ]
  }); 

  // Update stats when AJAX completes
  table.on('xhr.dt', function (e, settings, json, xhr) {
    if (json) {
      $('#valJenis').text(json.recordsFiltered || 0);
      $('#valStock').text(json.totalQty || 0);
      $('#valHabis').text(json.outOfStock || 0);
    }
  });

  $('#filterKategori').on('change', function() {
    table.ajax.reload();
  });

  $('#filterMinus').on('change', function() {
    table.ajax.reload();
  });

  // Clicking the minus stat card toggles the filter
  $('#cardMinus').on('click', function() {
    $('#filterMinus').prop('checked', !$('#filterMinus').is(':checked'));
    table.ajax.reload();
  });
});
  </script>

  <%- include('../partials/bottom') %>