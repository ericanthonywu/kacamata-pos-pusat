<% function fmtRp(v) { return 'Rp ' + Number(v||0).toLocaleString('id-ID'); } function fmtDate(d) { return d ? new
  Date(d).toLocaleDateString('id-ID') : '-' ; } %>
  <%- include('../partials/top', { title, activePage }) %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <div></div>
      <a href="/penjualan-retur/baru" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Retur Baru</a>
    </div>

    <div class="card p-3">
      <table id="tblReturJual" class="table table-hover mb-0" style="width:100%">
        <thead>
          <tr>
            <th>Kode Retur</th>
            <th>Tanggal</th>
            <th>No Nota</th>
            <th>Pelanggan</th>
            <th>Total Retur</th>
            <th style="width:120px">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% data.forEach(function(item) { %>
            <tr>
              <td class="font-monospace text-warning">
                <%= item.kode_retur %>
              </td>
              <td>
                <%= fmtDate(item.tanggal_retur) %>
              </td>
              <td class="font-monospace text-info">
                <%= item.no_nota || '-' %>
              </td>
              <td>
                <%= item.pelanggan_nama || '-' %>
              </td>
              <td class="fw-bold">
                <%= fmtRp(item.total_retur) %>
              </td>
              <td>
                <button class="btn btn-sm btn-outline-info me-1" onclick="showDetail(<%= item.id %>)"><i
                    class="bi bi-eye"></i></button>
                <button class="btn btn-sm btn-outline-danger" onclick="confirmVoid(<%= item.id %>)"><i
                    class="bi bi-x-circle"></i></button>
              </td>
            </tr>
            <% }); %>
        </tbody>
      </table>
    </div>

    <div class="modal fade" id="detailModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Detail Retur Penjualan</h5><button type="button" class="btn-close"
              data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" id="detailBody"></div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="voidModal" tabindex="-1">
      <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-body text-center py-4">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size:2.5rem"></i>
            <h5 class="mt-3">Batalkan Retur?</h5>
            <p class="text-muted small">Stok barang akan dikurangi kembali.</p>
          </div>
          <div class="modal-footer justify-content-center border-0 pt-0">
            <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kembali</button>
            <button class="btn btn-danger btn-sm" id="voidBtn">Ya, Batalkan</button>
          </div>
        </div>
      </div>
    </div>

    <script>
$(function() { $('#tblReturJual').DataTable({ order: [], language: dtLanguageID }); });

function showDetail(id) {
  $.get('/penjualan-retur/' + id, function(res) {
    if (!res.success) return;
    var d = res.data;
    var html = '<table class="table table-sm mb-0">';
    html += '<tr><td class="text-muted">Kode Retur</td><td class="font-monospace">' + d.kode_retur + '</td></tr>';
    html += '<tr><td class="text-muted">No Nota</td><td class="font-monospace">' + (d.no_nota || '-') + '</td></tr>';
    html += '<tr><td class="text-muted">Tanggal</td><td>' + new Date(d.tanggal_retur).toLocaleDateString('id-ID') + '</td></tr>';
    html += '</table>';
    if (d.detail && d.detail.length > 0) {
      html += '<hr><h6 class="small fw-bold">Item Retur</h6>';
      html += '<table class="table table-sm mb-0"><thead><tr><th>Tipe</th><th>Barang</th><th>Qty</th><th>Harga</th></tr></thead><tbody>';
      d.detail.forEach(function(item) {
        var tipe = item.tipe === 'frame' ? 'Frame' : item.tipe === 'lensa_l' ? 'Lensa L' : 'Lensa R';
        html += '<tr><td>' + tipe + '</td><td>' + (item.nama_barang || '-') + '</td><td>' + item.jumlah + '</td><td>' + fmtRp(item.harga) + '</td></tr>';
      });
      html += '</tbody></table>';
    }
    html += '<hr><div class="d-flex justify-content-between"><strong>Total Retur</strong><strong class="text-warning">' + fmtRp(d.total_retur) + '</strong></div>';
    $('#detailBody').html(html);
    new bootstrap.Modal('#detailModal').show();
  });
}

var voidId = null;
function confirmVoid(id) { voidId = id; new bootstrap.Modal('#voidModal').show(); }
$('#voidBtn').on('click', function() {
  if (!voidId) return;
  var btn = this;
  if (!setBtnLoading(btn)) return;
  $.ajax({ url: '/penjualan-retur/' + voidId, method: 'DELETE',
    success: function() { location.reload(); },
    error: function(xhr) { showToast((xhr.responseJSON && xhr.responseJSON.message) || 'Gagal', 'danger'); resetBtn(btn); }
  });
});
    </script>

    <%- include('../partials/bottom') %>