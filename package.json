    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "express-session": "1.18.1",
    "jquery": "3.7.1",
    "jsbarcode": "3.11.6",
    "jszip": "3.10.1",
    "knex": "2.5.1",
    "nodemon": "2.0.22",
    "pg": "8.13.1",
